// Grafana Alloy Configuration for OpenMentor
// This configuration handles metrics and logs collection for all services in Docker Compose
// Runs as a separate container that scrapes the frontend, backend and worker services

// Logging configuration
logging {
  level  = coalesce(sys.env("LOG_LEVEL"), "info")
  format = "logfmt"
}

prometheus.scrape "cadvisor" {
  targets = [
    {
      __address__ = "cadvisor:8080",
      instance    = coalesce(sys.env("HOSTNAME"), "cadvisor"),
      environment = coalesce(sys.env("APP_ENV"), "production"),
      service_name = "yc-cadvisor",
      namespace   = coalesce(sys.env("O11Y_SERVICE_NAMESPACE"), "openmentor-io"),
    },
  ]
  forward_to = [prometheus.relabel.clean_container_labels.receiver]
  scrape_interval = coalesce(sys.env("PROMETHEUS_SCRAPE_INTERVAL"), "30s")
  metrics_path = "/metrics"
}

// Prometheus metrics scraping - Go API Backend
prometheus.scrape "yc_go_api" {
  targets = [
    {
      __address__ = string.format("backend:%s", coalesce(sys.env("PORT"), "8081")),
      instance    = coalesce(sys.env("HOSTNAME"), "backend"),
      environment = coalesce(sys.env("APP_ENV"), "production"),
      service_name = coalesce(sys.env("O11Y_BE_SERVICE_NAME"), "openmentor-api"),
      namespace   = coalesce(sys.env("O11Y_SERVICE_NAMESPACE"), "openmentor-io"),
    },
  ]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = coalesce(sys.env("PROMETHEUS_SCRAPE_INTERVAL"), "30s")
  metrics_path    = "/api/metrics"
}

// Prometheus metrics scraping - Go Background Worker
prometheus.scrape "yc_go_worker" {
  targets = [
    {
      __address__ = string.format("worker:%s", coalesce(sys.env("WORKER_PORT"), "8090")),
      instance    = coalesce(sys.env("HOSTNAME"), "worker"),
      environment = coalesce(sys.env("APP_ENV"), "production"),
      service_name = coalesce(sys.env("O11Y_WORKER_SERVICE_NAME"), "openmentor-worker"),
      namespace   = coalesce(sys.env("O11Y_SERVICE_NAMESPACE"), "openmentor-io"),
      // Per-VM identity, for the same reason the backup gauges carry it (D70):
      // ProfilePurgeStale evaluates the retention sweep PER DEPLOYMENT, and
      // none of the labels above can carry that. `./deploy.sh --staging`
      // uploads the same .env.production, so a staging worker remote-writes to
      // this tenant with an identical environment and service_name, and
      // `instance` is Alloy's own container id (Docker's HOSTNAME), which
      // changes on every recreate. Without this, a global max() over the purge
      // gauges lets a healthy staging sweep hold the rule Normal while
      // production stops erasing data it has promised to erase.
      deployment  = coalesce(sys.env("DEPLOYMENT_NAME"), "production"),
    },
  ]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = coalesce(sys.env("PROMETHEUS_SCRAPE_INTERVAL"), "30s")
  metrics_path    = "/metrics"
}

// Prometheus metrics scraping - Next.js frontend
prometheus.scrape "yc_nextjs_frontend" {
  targets = [
    {
      __address__ = "frontend:3000",
      instance    = coalesce(sys.env("HOSTNAME"), "frontend"),
      environment = coalesce(sys.env("APP_ENV"), "production"),
      service_name = coalesce(sys.env("O11Y_FE_SERVICE_NAME"), "openmentor-frontend"),
      namespace   = coalesce(sys.env("O11Y_SERVICE_NAMESPACE"), "openmentor-io"),
    },
  ]
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = coalesce(sys.env("PROMETHEUS_SCRAPE_INTERVAL"), "30s")
  metrics_path    = "/api/metrics"

  // SECURITY: Send bearer token to access frontend metrics
  bearer_token = sys.env("METRICS_AUTH_TOKEN")
}

// Postgres backup freshness (P8)
//
// The postgres-backup sidecar writes two gauges as a Prometheus textfile
// (openmentor_db_backup_last_{success,failure}_timestamp_seconds) into the
// shared `openmentor-backup-metrics` volume, mounted here read-only. Chosen
// over a loki.source.docker scrape of the sidecar's stdout deliberately: that
// would need /var/run/docker.sock bind-mounted into Alloy, i.e. root-equivalent
// host access for the container that also holds every Grafana Cloud
// credential. A gauge is also what the staleness alert
// (grafana/alerting/alert-rules.yaml, om-db-backup-stale) and the
// om-database-infra panel actually need.
prometheus.exporter.unix "backup_metrics" {
  set_collectors = ["textfile"]

  textfile {
    directory = "/var/lib/alloy/backup-metrics"
  }
}

discovery.relabel "backup_metrics" {
  targets = prometheus.exporter.unix.backup_metrics.targets

  rule {
    target_label = "instance"
    replacement  = coalesce(sys.env("HOSTNAME"), "postgres-backup")
  }

  rule {
    target_label = "environment"
    replacement  = coalesce(sys.env("APP_ENV"), "production")
  }

  rule {
    target_label = "service_name"
    replacement  = "openmentor-postgres-backup"
  }

  rule {
    target_label = "namespace"
    replacement  = coalesce(sys.env("O11Y_SERVICE_NAMESPACE"), "openmentor-io")
  }

  // Backup freshness has to be evaluated PER DEPLOYMENT, and none of the labels
  // above can carry that: `./deploy.sh --staging` uploads the same
  // .env.production, so a staging VM remote-writes to this same Grafana Cloud
  // tenant with APP_ENV=production too, and `instance` is the alloy container id
  // (Docker's default HOSTNAME), which changes on every recreate. Without a
  // stable per-VM label a global max() over these gauges lets one fresh staging
  // backup hold DatabaseBackupStale Normal while production dumps rot.
  // deploy.sh writes DEPLOYMENT_NAME into the VM's .env from the deploy target.
  rule {
    target_label = "deployment"
    replacement  = coalesce(sys.env("DEPLOYMENT_NAME"), "production")
  }
}

prometheus.scrape "backup_metrics" {
  targets         = discovery.relabel.backup_metrics.output
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = coalesce(sys.env("PROMETHEUS_SCRAPE_INTERVAL"), "30s")
}

// Self-monitoring: Grafana Alloy metrics
prometheus.scrape "yc_alloy_self_monitoring" {
  targets = [
    {
      __address__ = "localhost:12345",
      instance    = coalesce(sys.env("HOSTNAME"), "alloy"),
      environment = coalesce(sys.env("APP_ENV"), "production"),
      service_name = "openmentor-o11y",
      namespace   = coalesce(sys.env("O11Y_SERVICE_NAMESPACE"), "openmentor-io"),
    },
  ]
  forward_to      = [prometheus.relabel.drop_unused_metrics.receiver]
  scrape_interval = coalesce(sys.env("PROMETHEUS_SCRAPE_INTERVAL"), "30s")
}

// Clean verbose container labels but keep essential ones
prometheus.relabel "clean_container_labels" {
  // Drop unnecessary Docker Compose labels (SAFE - not used in dashboards)
  rule {
    regex  = "container_label_com_docker_compose_(config_hash|depends_on|image)"
    action = "labeldrop"
  }

  rule {
    regex  = "container_label_org_opencontainers_image_(source|version)"
    action = "labeldrop"
  }

  forward_to = [prometheus.relabel.drop_unused_metrics.receiver]
}

// Drop truly unused metrics only
prometheus.relabel "drop_unused_metrics" {
  // Drop alloy internal metrics
  rule {
    source_labels = ["__name__"]
    regex         = "alloy_(component_dependencies_wait_seconds.*|component_evaluation_seconds.*|labelstore_.*)"
    action        = "drop"
  }

  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// Prometheus remote write to Grafana Cloud
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = sys.env("GCLOUD_HOSTED_METRICS_URL")

    basic_auth {
      username = sys.env("GCLOUD_HOSTED_METRICS_ID")
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

// Log collection from volume-mounted log directories
// Frontend, backend and worker write logs to /app/logs, which are mounted to Alloy as:
// - /var/log/frontend (frontend logs with daily rotation)
// - /var/log/backend (backend logs with size-based rotation)
// - /var/log/worker (worker logs with size-based rotation)

// Local file match for frontend log files
// Frontend uses winston-daily-rotate-file, creating files like app-2025-12-02.log
local.file_match "yc_frontend_logs" {
  path_targets = [
    {
      __path__    = "/var/log/frontend/app-*.log",
      job         = "nextjs",
      instance    = coalesce(sys.env("HOSTNAME"), "frontend"),
      environment = coalesce(sys.env("APP_ENV"), "production"),
      service_name = coalesce(sys.env("O11Y_FE_SERVICE_NAME"), "openmentor-frontend"),
      namespace   = coalesce(sys.env("O11Y_SERVICE_NAMESPACE"), "openmentor-io"),
    },
  ]
}

// Local file match for backend log files
// Backend uses lumberjack, creating files like app.log
local.file_match "yc_backend_logs" {
  path_targets = [
    {
      __path__    = "/var/log/backend/app.log",
      job         = "go-api",
      instance    = coalesce(sys.env("HOSTNAME"), "backend"),
      environment = coalesce(sys.env("APP_ENV"), "production"),
      service_name = coalesce(sys.env("O11Y_BE_SERVICE_NAME"), "openmentor-api"),
      namespace   = coalesce(sys.env("O11Y_SERVICE_NAMESPACE"), "openmentor-io"),
    },
  ]
}

// Local file match for worker log files
// Worker uses the same Zap+lumberjack logger as the backend (app.log)
local.file_match "yc_worker_logs" {
  path_targets = [
    {
      __path__    = "/var/log/worker/app.log",
      job         = "go-worker",
      instance    = coalesce(sys.env("HOSTNAME"), "worker"),
      environment = coalesce(sys.env("APP_ENV"), "production"),
      service_name = coalesce(sys.env("O11Y_WORKER_SERVICE_NAME"), "openmentor-worker"),
      namespace   = coalesce(sys.env("O11Y_SERVICE_NAMESPACE"), "openmentor-io"),
    },
  ]
}

// Loki source file - tail frontend logs
loki.source.file "frontend_logs" {
  targets    = local.file_match.yc_frontend_logs.targets
  forward_to = [loki.process.parse_json_logs.receiver]
}

// Loki source file - tail backend logs
loki.source.file "backend_logs" {
  targets    = local.file_match.yc_backend_logs.targets
  forward_to = [loki.process.parse_json_logs.receiver]
}

// Loki source file - tail worker logs
loki.source.file "worker_logs" {
  targets    = local.file_match.yc_worker_logs.targets
  forward_to = [loki.process.parse_json_logs.receiver]
}

// Loki process - parse JSON logs and extract fields
loki.process "parse_json_logs" {
  // Forwards to redact_pii, NOT straight to loki.write: every path into Loki has
  // to pass the redaction choke point (C11).
  forward_to = [loki.process.redact_pii.receiver]

  // Parse JSON log format (Winston for frontend, Zap for backend)
  stage.json {
    expressions = {
      timestamp = "timestamp",
      level     = "level",
      message   = "message",
      // Trace context fields (OpenTelemetry)
      trace_id    = "trace_id",
      span_id     = "span_id",
      trace_flags = "trace_flags",
      // Backend-specific fields (Zap)
      caller    = "caller",
      method    = "method",
      path      = "path",
      status    = "status",
      duration  = "duration",
      error     = "error",
    }
  }

  // Use timestamp from log entry (ISO 8601 format)
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339"
  }

  // Add labels extracted from JSON log fields
  // Note: service_name label comes from path_targets (lines 135, 151), not from log content
  stage.labels {
    values = {
      level = "level",
    }
  }

  // Trace correlation: promote trace/span ids to Loki structured metadata
  // (queryable + usable by Grafana logs->traces derived links without the
  // cardinality cost of labels).
  stage.structured_metadata {
    values = {
      trace_id = "trace_id",
      span_id  = "span_id",
    }
  }

  // Set message as output
  // stage.output {
  //   source = "message"
  // }
}

// Loki process - LAST-RESORT PII/secret redaction before anything leaves the host
//
// This is defense in depth, not the fix. The fix is in the application:
// api/pkg/redact owns the rules, pkg/logger installs them as a zapcore wrapper
// every field passes through, and the call sites mask explicitly. This stage
// exists because C11 found a line that had been reviewed twice and still shipped
// a real address to Loki on every email the platform sent — so a rule that does
// not depend on any Go code being correct is worth its cost.
//
// WHY THE MARKERS ARE LOUD AND DIFFERENT FROM THE GO MASKS
// The Go masker turns an address into `j***@example.com`. This stage turns it
// into `[REDACTED_EMAIL]@example.com` instead of the same shape on purpose: a
// line carrying that marker means the application layer failed to redact, and
// that has to be conspicuous in Loki rather than silently indistinguishable from
// a correctly-masked line. It is a bug report, not a cover-up.
//
// WHY ONLY stage.replace
// A bad stage in a live pipeline can stop logs reaching Loki entirely. Every
// stage here is a stage.replace, which can only ever rewrite bytes inside a line
// — there is deliberately no stage.drop, no stage.match and no stage.output, so
// the worst failure mode available to this component is an ugly replacement.
//
// WHY THE CAPTURE GROUPS LOOK LIKE THAT
// stage.replace substitutes the CAPTURE GROUPS, not the whole match (that is what
// `replace` means here). So each expression matches enough context to be sure of
// what it found and captures only the bytes that must not survive. The
// surrounding JSON quoting is outside every group, which keeps the line valid
// JSON for the query-time parser — the char classes all exclude `"` for the same
// reason. Verified by infra/alloy-redaction-test.sh.
//
// Note the log line reaching this component is the RAW json, because
// parse_json_logs leaves stage.output commented out. That is why these
// expressions carry no `source` argument: they must run over the whole line, not
// over the extracted map, which is not what gets written.
loki.process "redact_pii" {
  forward_to = [loki.write.grafana_cloud.receiver]

  // Connection-string passwords. First, so the email rule below cannot claim the
  // password of a DSN whose host happens to look like a domain.
  //
  // The value's FIRST character excludes `*` and `[` so the Go layer's own
  // correct outputs — redact.DSN's `user:***@host` and this stage's own
  // `[REDACTED_SECRET]` — do not re-match. That is what keeps the marker's
  // meaning: a [REDACTED_SECRET] in Loki is a value the application layer
  // MISSED, not one it already masked. (A real password that starts with `*`
  // or `[` slips this stage — accepted; the Go layer is the primary net.)
  stage.replace {
    expression = "(?i)(?:postgres|postgresql|mysql|mongodb|redis|amqp|amqps)(?:\\+[a-z0-9]+)?://[^:/@\\s\"]+:([^@\\s\"*\\[][^@\\s\"]*)@"
    replace    = "[REDACTED_SECRET]"
  }

  // Credentials in key=value or "key":"value" form. The key list is spelled out
  // rather than derived so this stage cannot start eating fields nobody meant it
  // to: `login_token_ttl_minutes` does not match, because a key here must be
  // followed by a separator. First value character excludes `*` and `[` for the
  // same reason as the DSN stage: the core's `[REDACTED]` placeholder and a
  // `***` mask are correct outputs, not leaks.
  stage.replace {
    expression = "(?i)(?:password|passwd|secret|api[-_]?key|access[-_]?key|auth[-_]?token|bearer|[a-z_]*token)[\"']?\\s*[:=]\\s*[\"']?([^\"'\\s,}&*\\[][^\"'\\s,}&]*)"
    replace    = "[REDACTED_SECRET]"
  }

  // Email addresses. The local part goes; the domain stays, because a
  // deliverability failure is domain-wide and the domain is what an operator
  // triages with. An already-masked `j***@example.com` does not match — `*` is
  // not in the local-part class — so this never double-mangles a correct line.
  stage.replace {
    expression = "([A-Za-z0-9._%+\\-]+)@[A-Za-z0-9](?:[A-Za-z0-9\\-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9\\-]*[A-Za-z0-9])?)*\\.[A-Za-z]{2,}"
    replace    = "[REDACTED_EMAIL]"
  }
}

// Loki write to Grafana Cloud
loki.write "grafana_cloud" {
  endpoint {
    url = sys.env("GCLOUD_HOSTED_LOGS_URL")

    basic_auth {
      username = sys.env("GCLOUD_HOSTED_LOGS_ID")
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

// Pyroscope receiver for push-mode profiling from backend
pyroscope.receive_http "default" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 4040
  }

  forward_to = [pyroscope.write.grafana_cloud.receiver]
}

// Pyroscope write to Grafana Cloud Profiles
pyroscope.write "grafana_cloud" {
  endpoint {
    url = sys.env("GCLOUD_HOSTED_PROFILES_URL")

    basic_auth {
      username = sys.env("GCLOUD_HOSTED_PROFILES_ID")
      password = sys.env("GCLOUD_RW_API_KEY")
    }
  }
}

// OpenTelemetry receiver for traces (HTTP & gRPC)
otelcol.receiver.otlp "default" {
  http {
    endpoint = "0.0.0.0:4318"
  }

  grpc {
    endpoint = "0.0.0.0:4317"
  }

  output {
    traces = [otelcol.processor.resourcedetection.default.input]
  }
}

otelcol.processor.resourcedetection "default" {
	// https://grafana.com/docs/alloy/latest/reference/components/otelcol.processor.resourcedetection/
	detectors = ["env", "system"]

	system {
		hostname_sources = ["os"]
	}

	output {
		traces  = [otelcol.processor.transform.drop_unneeded_resource_attributes.input]
	}
}

otelcol.processor.transform "drop_unneeded_resource_attributes" {
	// https://grafana.com/docs/alloy/latest/reference/components/otelcol.processor.transform/
	error_mode = "ignore"

	trace_statements {
		context    = "resource"
		statements = [
			"delete_key(attributes, \"k8s.pod.start_time\")",
			"delete_key(attributes, \"os.description\")",
			"delete_key(attributes, \"process.command_args\")",
			"delete_key(attributes, \"process.executable.path\")",
			// Keep these attributes for correlation and debugging:
			// - process.pid: Correlate with container metrics
			// - process.runtime.*: Identify runtime version/environment
			// - os.type: Useful for multi-platform deployments
		]
	}

	output {
		traces  = [
			otelcol.processor.batch.default.input,
			otelcol.connector.host_info.default.input,
		]
	}
}

otelcol.connector.host_info "default" {
	// https://grafana.com/docs/alloy/latest/reference/components/otelcol.connector.host_info/
	host_identifiers = ["host.name"]

	output {
		metrics = [otelcol.processor.batch.default.input]
	}
}

otelcol.processor.batch "default" {
	// https://grafana.com/docs/alloy/latest/reference/components/otelcol.processor.batch/
	output {
		traces  = [otelcol.exporter.otlphttp.grafana_cloud.input]
		metrics = [otelcol.exporter.otlphttp.grafana_cloud.input]
	}
}

// OpenTelemetry exporter to Grafana Cloud Tempo (HTTP mode)
otelcol.exporter.otlphttp "grafana_cloud" {
  client {
    endpoint = sys.env("GCLOUD_HOSTED_TRACES_URL")
    auth = otelcol.auth.basic.grafana_cloud.handler
  }
}

otelcol.auth.basic "grafana_cloud" {
  username = sys.env("GCLOUD_HOSTED_TRACES_ID")
  password = sys.env("GCLOUD_RW_API_KEY")
}

// ============================================================================
// Database Observability - PostgreSQL (local `postgres` compose container)
//
// Collects query details, query samples, explain plans, and schema information
// via direct SQL connection. Forwards structured logs to Grafana Cloud Loki and
// exports Prometheus metrics to Grafana Cloud.
//
// The "logs" collector is disabled: the containerized PostgreSQL logs to
// stdout (shipped via the Docker log driver), not to files Alloy could tail.
//
// Prerequisites (manual, one-time — full walkthrough in
// ../../docs/runbooks/database-observability.md):
//   1. pg_stat_statements preloaded + compute_query_id=on etc. — set via the
//      postgres service `command` in docker-compose.yml (requires restart)
//   2. In the openmentor database:
//        CREATE EXTENSION IF NOT EXISTS pg_stat_statements;
//   3. Create a monitoring user:
//        CREATE USER grafana_monitoring WITH PASSWORD '...';
//        GRANT pg_monitor TO grafana_monitoring;
//        GRANT pg_read_all_stats TO grafana_monitoring;
//        GRANT pg_read_all_data TO grafana_monitoring;  -- schema_details/explain_plans
//        ALTER ROLE grafana_monitoring SET pg_stat_statements.track = 'none';
//   Requires Alloy >= 1.17.0 (compose pins the image).
//
// Required files on VM (created by deploy.sh):
//   /opt/openmentor-infra/alloy-secrets/postgres_secret_openmentor
//     → one-line DSN, e.g.:
//       postgres://grafana_monitoring:pass@postgres:5432/openmentor?sslmode=disable
//
// Required env var in .env.production:
//   POSTGRES_OBS_DSN=postgres://grafana_monitoring:pass@postgres:5432/openmentor?sslmode=disable
// ============================================================================

local.file "postgres_secret_openmentor" {
  filename  = "/var/lib/alloy/secrets/postgres_secret_openmentor"
  is_secret = true
}

prometheus.exporter.postgres "postgres_openmentor" {
  data_source_names  = [coalesce(sys.env("POSTGRES_OBS_DSN"), local.file.postgres_secret_openmentor.content)]
  // enabled_collectors REPLACES the exporter's default set — list everything
  // the om-database-infra "PostgreSQL (server)" panels need (TPS/cache-hit
  // from stat_database, pg_locks_count, pg_database_size_bytes).
  enabled_collectors = ["stat_statements", "stat_database", "locks", "database"]

  stat_statements {
    exclude_users = ["grafana_monitoring"]
  }
}

database_observability.postgres "postgres_openmentor" {
  data_source_name   = local.file.postgres_secret_openmentor.content
  forward_to         = [loki.relabel.database_observability_postgres_openmentor.receiver]
  targets            = prometheus.exporter.postgres.postgres_openmentor.targets
  enable_collectors = ["query_details", "query_samples", "schema_details", "explain_plans"]
  exclude_users     = ["grafana_monitoring"]
  exclude_databases = ["postgres"]
}

loki.relabel "database_observability_postgres_openmentor" {
  // Through redact_pii, not straight to loki.write. This path was the one the
  // application-level redaction can never reach: query_samples and explain_plans
  // ship the SQL Postgres actually ran, literals included, so a
  // `WHERE email = '…'` lands in Loki with the address in it. It was also the
  // easiest leak to miss, because nothing about it goes through Go code (C11).
  forward_to = [loki.process.redact_pii.receiver]

  rule {
    target_label = "service_name"
    replacement  = "openmentor-postgres"
  }

  rule {
    target_label = "instance"
    replacement  = "db-openmentor-pg"
  }

  rule {
    target_label = "namespace"
    replacement  = "openmentor"
  }
}

discovery.relabel "database_observability_postgres_openmentor" {
  targets = database_observability.postgres.postgres_openmentor.targets

  rule {
    target_label = "job"
    replacement  = "integrations/db-o11y"
  }

  rule {
    source_labels = ["instance"]
    target_label  = "dsn"
  }

  rule {
    target_label = "instance"
    replacement  = "db-openmentor-pg"
  }

  rule {
    target_label = "service_name"
    replacement  = "openmentor-postgres"
  }

  rule {
    target_label = "namespace"
    replacement  = "openmentor"
  }
}

prometheus.scrape "postgres_openmentor" {
  targets         = discovery.relabel.database_observability_postgres_openmentor.output
  forward_to      = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = coalesce(sys.env("PROMETHEUS_SCRAPE_INTERVAL"), "30s")
}
