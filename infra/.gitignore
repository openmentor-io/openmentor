# Environment files. A catch-all rather than a list of known names, and
# deliberately duplicated from the repo-root .gitignore: the deploy rsyncs this
# directory on its own, so any env file covered only by the root rule (e.g. the
# generated `.env.runtime`, a plaintext copy of every secret in `.env`) loses
# its rule the moment infra/ is used outside the monorepo. Templates are
# `*.example` and stay tracked.
.env
.env.*
!.env.example
!.env.*.example

# Docker volumes
/volumes/

# Logs
*.log
logs/

# System files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Secrets
secrets/
*.key
*.pem
*.crt
*.csr
# Exception: Yandex's PUBLIC managed-Postgres cluster CA used by
# migration/migrate-mentors.js to verify the source DB's TLS (not a secret).
!migration/yandex-ca.pem

# Backup files
*.bak
*.backup

# Migration cache
migration/.migration-cache/
